generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USERS
enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String

  role         UserRole @default(CUSTOMER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
