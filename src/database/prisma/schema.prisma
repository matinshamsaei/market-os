generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USERS
enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String

  role         UserRole @default(CUSTOMER)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products     Product[]

  @@map("users")
}

// PRODUCTS
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id           String   @id @default(uuid())
  title        String
  description  String
  price        Float
  status       ProductStatus @default(DRAFT)

  vendor       User     @relation(fields: [vendorId], references: [id])
  vendorId     String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vendorId])
  @@map("products")
}
