generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// USERS
enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String

  role UserRole @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  carts    Cart[]

  @@map("users")
}

// PRODUCTS
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Product {
  id          String         @id @default(uuid())
  title       String
  description String?
  price       Float
  status      ProductStatus? @default(DRAFT)

  vendor   User   @relation(fields: [vendorId], references: [id])
  vendorId String

  inventory Inventory?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]

  @@index([vendorId])
  @@map("products")
}

// Inventories
model Inventory {
  id       String @id @default(uuid())
  quantity Int

  product   Product @relation(fields: [productId], references: [id])
  productId String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventories")
}

model Cart {
  id String @id @default(uuid())

  customer   User   @relation(fields: [customerId], references: [id])
  customerId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems CartItem[]

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id String @id @default(uuid())

  cart   Cart   @relation(fields: [cartId], references: [id])
  cartId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}
